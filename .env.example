# --- Providers ---

# Primary provider — self-hosted yt-dlp backend (Docker + Cloudflare Tunnel)
# Must be a STABLE public URL (named tunnel). Quick-tunnel URLs rotate on restart.
YTDLP_API_URL=https://your-tunnel-url.trycloudflare.com
# Used by the backend itself to build stream URLs
YTDLP_PUBLIC_URL=https://your-tunnel-url.trycloudflare.com

# Fallback provider — free key at https://rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key_here

# Optional: override the resolver User-Agent used by the backend
# RESOLVER_USER_AGENT=Mozilla/5.0 ...

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=DownloadVTViral

# --- Shortlink monetization ---
SHORTLINK_API_URL=https://punyasahlan.my.id/api/v3/links
SHORTLINK_AD_DELAY=5

# --- Admin authentication ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123